{
  "name": "agentsync",
  "productName": "AgentSync",
  "version": "0.1.0",
  "private": true,
  "description": "Claude と GPT が同居する、LINE 風のデスクトップアプリ",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac -c.electronDist=node_modules/electron/dist",
    "dist:win": "electron-vite build && electron-builder --win --x64 --arm64 --publish never",
    "install:app": "npm run dist && sh scripts/install-app.sh",
    "preview": "node scripts/run.mjs node_modules/electron-vite/bin/electron-vite.js preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "node scripts/run.mjs --real-cli node_modules/vitest/vitest.mjs run tests/e2e",
    "icon": "node scripts/run.mjs node_modules/electron/cli.js scripts/render-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
